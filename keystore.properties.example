# Copy to keystore.properties (gitignored) and fill in. Create the key once with:
#   keytool -genkeypair -v -keystore ~/keys/retrieve-upload.jks -alias upload \
#           -keyalg RSA -keysize 4096 -validity 10000
# Back up the .jks file AND these passwords somewhere other than this laptop (password manager).
# Play App Signing holds the real app-signing key; this upload key can be reset via Play support
# if lost, but that takes days.
storeFile=/Users/you/keys/retrieve-upload.jks
storePassword=
keyAlias=upload
keyPassword=
